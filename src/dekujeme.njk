---
permalink: /dekujeme/index.html
noindex: true
---
{%- from "icons.njk" import ui -%}
{%- set tel = site.phone | tel -%}
{%- set phoneShort = site.phone | phoneShort -%}
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- set pageTitle = "Poptávka odeslána | " + site.name %}{% set pageDesc = "Poptávka dorazila, ozveme se s cenou a termínem." %}{% set noindex = true %}
  {%- include "seo-head.njk" %}
  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<!-- Sem formulář poptávky přesměruje po odeslání (Netlify Forms, atribut action) -->
<header class="site-header is-scrolled">
  <div class="header-inner">
    <a class="brand" href="/" aria-label="{{ site.name }}, úvod">
      <img eleventy:ignore src="/img/logo.jpg" alt="{{ site.name }}" width="960" height="616">
    </a>
    <a class="btn btn-pink btn-sm" href="tel:{{ tel }}"><span>{{ phoneShort }}</span><span class="btn-ico">{{ ui("phone") }}</span></a>
  </div>
</header>

<main class="thanks">
  <div class="wrap">
    <h1 class="display steel">Poptávka dorazila</h1>
    <p class="lead">Děkujeme. Projdeme fotky a ozveme se vám s cenou a termínem. Když spěcháte, zavolejte nám.</p>
    <div class="actions">
      <a class="btn btn-pink" href="tel:{{ tel }}"><span>Zavolat {{ phoneShort }}</span><span class="btn-ico">{{ ui("phone") }}</span></a>
      <a class="btn btn-steel" href="/"><span>Zpět na web</span></a>
    </div>
  </div>
</main>

</body>
</html>
